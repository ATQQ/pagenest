{
  "name": "pagenest",
  "version": "0.3.0",
  "description": "PageNest / 页栖: a local-first Markdown reading, editing, and version history studio.",
  "type": "module",
  "bin": {
    "pn": "./bin/pagenest.js",
    "pagenest": "./bin/pagenest.js"
  },
  "exports": {
    "./server": "./dist/server/server.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "TECHNICAL_PLAN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:server": "tsx watch ./src/cli/index.ts --no-open",
    "dev:client": "vite",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "clean": "rimraf dist coverage",
    "start": "node ./bin/pagenest.js .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "themes:gen": "tsx ./scripts/gen-themes.ts && prettier --write src/client/styles/reference-themes.css src/client/public/theme-init.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run pack:check"
  },
  "keywords": [
    "markdown",
    "editor",
    "local-first",
    "cli",
    "notes",
    "knowledge-base",
    "version-history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATQQ/pagenest.git"
  },
  "homepage": "https://github.com/ATQQ/pagenest#readme",
  "bugs": {
    "url": "https://github.com/ATQQ/pagenest/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "diff": "9.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "github-slugger": "2.0.0",
    "jsdom": "28.1.0",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-react": "8.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rimraf": "6.1.3",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
